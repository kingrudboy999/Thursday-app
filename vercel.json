{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/downloads/thursday-offline.html",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Thursday.html\""
        }
      ]
    },
    {
      "source": "/downloads/thursday-react-native.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"thursday-react-native.zip\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|downloads/|favicon|apple-touch-icon|thursday-icon|manifest\\.webmanifest|sw\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
